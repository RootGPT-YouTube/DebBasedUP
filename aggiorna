#!/bin/bash
#
# aggiorna — Debian-based maintenance & update helper
# by R∞tGPT — original "pipeline" interface (unrelated to Nala)
#
# Engine: apt-get driven through the APT::Status-Fd machine interface, so the
# download/install progress is parsed from a stable frontend protocol instead
# of scraping human-readable text.
#

#== Colors (real ESC, so they work both with printf and echo) ================
RESET=$'\e[0m'
BOLD=$'\e[1m'
DIM=$'\e[38;2;96;106;128m'      # slate-grey for the rules
GREEN=$'\e[38;2;80;220;130m'
RED=$'\e[38;2;255;95;95m'
CYAN=$'\e[38;2;0;220;210m'
GOLD=$'\e[38;2;255;200;90m'

#== Global state =============================================================
steps_ok=0
steps_fail=0
SCRIPT_UPDATE='—'
FIRST_STEP=1
REBOOT_REASONS=()   # why a reboot is needed, filled by detect_reboot_needed

# The TOTAL bar runs on a fixed 0..1000 per-mille scale split into three phase
# bands — download / install / flatpak — weighted 30/40/30 of the whole bar
# (planned up-front in plan_phase). A phase with no work has its weight handed
# to the phases that do, so the bar always spans a full 0→100% with no stalls.
G_TOTAL_PKG=0    # total packages across every section (Cromite excluded) — label only

# Pre-resolved plan (filled by plan_phase)
APT_UPG=0
APT_REM=0
FU_REFS=()       # Flatpak refs to update
FX_REFS=()       # unused Flatpak refs to remove

# Per-mille band boundaries on the TOTAL bar (filled by plan_phase). Each section
# fills its [lo,hi] slice; boundaries are contiguous so the bar never jumps back.
B_DLU_HI=300     # download (APT full-upgrade): 0 .. B_DLU_HI
B_INU_HI=500     # install, upgrade share:      B_DLU_HI .. B_INU_HI
B_INA_HI=700     # install, autoremove:         B_INU_HI .. B_INA_HI
B_FPU_HI=850     # flatpak update share:        B_INA_HI .. B_FPU_HI
                 # flatpak remove share:        B_FPU_HI .. 1000

# Live block bookkeeping
LIVE_DRAWN=0
LIVE_LINES=3
SPIN=('◜' '◠' '◝' '◞' '◡' '◟')   # rotating arc (not braille!)

# Terminal geometry for the fixed TOTAL footer (bottom 2 reserved rows)
TERM_ROWS=24
TERM_COLS=80

#== Diario di bordo (facoltativo) ===========================================
# `AGGIORNA_DEBUG=1 aggiorna` tiene un diario in /tmp/aggiorna-debug-<pid>/:
# una riga con l'ora a ogni passo e a ogni domanda, più l'output completo di
# ogni comando, che di norma viene buttato via appena il passo finisce.
#
# Serve per una cosa sola, ma importante: quando lo script *sembra* fermo e lo
# schermo non dice perché, il diario dice a che punto era arrivato, a che ora, e
# che cosa stava aspettando. Senza, di un blocco non resta alcuna traccia — ed è
# così che su Fedora è stato trovato uno stallo che durava da settimane.
DEBUG_DIR=''
if [ -n "${AGGIORNA_DEBUG:-}" ]; then
    DEBUG_DIR="/tmp/aggiorna-debug-$$"
    mkdir -p "$DEBUG_DIR" 2>/dev/null || DEBUG_DIR=''
fi

trace() {
    [ -n "$DEBUG_DIR" ] || return 0
    printf '%s  %s\n' "$(date '+%H:%M:%S')" "$1" >> "$DEBUG_DIR/diario.txt"
}

# Fine di un passo: butta il log com'e' sempre stato, ma se il diario e' attivo
# lo conserva prima, con il nome del passo.
drop_log() {
    local log=$1 label=$2
    if [ -n "$DEBUG_DIR" ] && [ -s "$log" ]; then
        cp "$log" "$DEBUG_DIR/$(printf '%s' "$label" | tr -c 'A-Za-z0-9._-' '_').log" 2>/dev/null
    fi
    trace "fine:   $label"
    rm -f "$log"
}

#== Utilities ================================================================

# repeat a (possibly multibyte) character n times
rep() { local n=$1 ch=$2 i; for ((i=0; i<n; i++)); do printf '%s' "$ch"; done; }

# write text applying a truecolor gradient from (r1,g1,b1) to (r2,g2,b2)
grad_text() {
    local text="$1" r1=$2 g1=$3 b1=$4 r2=$5 g2=$6 b2=$7
    local len=${#text} i r g b den
    den=$(( len > 1 ? len - 1 : 1 ))
    for ((i=0; i<len; i++)); do
        r=$(( r1 + (r2 - r1) * i / den ))
        g=$(( g1 + (g2 - g1) * i / den ))
        b=$(( b1 + (b2 - b1) * i / den ))
        printf '\e[1m\e[38;2;%d;%d;%dm%s' "$r" "$g" "$b" "${text:i:1}"
    done
    printf '%s' "$RESET"
}

fmt_time() { printf '%02d:%02d' $(( $1 / 60 )) $(( $1 % 60 )); }

kb_to_human() {
    local kb=$1 sign=''
    (( kb < 0 )) && { sign='-'; kb=$(( -kb )); }
    if   (( kb >= 1048576 )); then printf '%s%d.%d GiB' "$sign" $(( kb/1048576 )) $(( (kb%1048576)*10/1048576 ))
    elif (( kb >= 1024    )); then printf '%s%d MiB' "$sign" $(( kb/1024 ))
    else                           printf '%s%d KiB' "$sign" "$kb"
    fi
}

# truncate a string to n columns, appending an ellipsis when it was cut
trunc() {
    local s=$1 n=$2
    if (( ${#s} > n )); then printf '%s…' "${s:0:n-1}"; else printf '%s' "$s"; fi
}

# percentage done/total (0 when total is unknown)
pct() { local d=$1 t=$2; (( t <= 0 )) && { printf '0'; return; }; printf '%d' $(( d * 100 / t )); }

# a [██████░░░░] progress bar of the given width
draw_bar() {
    local d=$1 t=$2 w=$3 fill
    if (( t <= 0 )); then fill=0; else fill=$(( d * w / t )); fi
    (( fill > w )) && fill=$w; (( fill < 0 )) && fill=0
    printf '%s[%s%s%s%s%s]%s' \
        "$DIM" "$CYAN" "$(rep $fill '█')" "$DIM" "$(rep $(( w - fill )) '─')" "$DIM" "$RESET"
}

#== Gradient header ==========================================================
header() {
    local width
    width=$(( TERM_COLS < 56 ? TERM_COLS : 56 ))
    (( width < 24 )) && width=24
    local bar; bar=$(rep $(( width - 4 )) '━')

    echo
    printf '  '; grad_text "$bar" 60 110 200 0 220 210; echo
    printf '   '; grad_text "A G G I O R N A" 70 130 230 0 220 200
    printf '    %s•%s  ' "$DIM" "$RESET"; grad_text "R∞tGPT" 0 220 200 180 90 255
    printf '   %sv4.0%s' "$DIM" "$RESET"; echo
    printf '  '; grad_text "$bar" 0 220 210 60 110 200; echo
    echo
}

#== Fixed TOTAL footer (reserved bottom rows, outside the scroll region) ======
setup_footer() {
    TERM_ROWS=$(tput lines 2>/dev/null || echo 24)
    TERM_COLS=$(tput cols  2>/dev/null || echo 80)
    (( TERM_ROWS < 8 )) && TERM_ROWS=8
    printf '\e[1;%dr' $(( TERM_ROWS - 2 ))     # scroll region: rows 1 .. ROWS-2
    printf '\e[1;1H'                           # cursor back to the top
    draw_total_footer 0
}

teardown_footer() {
    printf '\e7'                               # save the content cursor
    printf '\e[%d;1H\e[K' $(( TERM_ROWS - 1 )) # clear the rule row
    printf '\e[%d;1H\e[K' "$TERM_ROWS"         # clear the bar row
    printf '\e[r'                              # restore full scroll region
    printf '\e8'                               # back to the content cursor
}

# Uscita anticipata (disclaimer rifiutato, autenticazione fallita): libera le
# righe riservate al footer, ripristina la scroll region e pulisce lo schermo —
# altrimenti header, footer e testo restano a sporcare il terminale. Lo schermo
# resta pulito come alla chiusura normale, con la sola riga di esito.
exit_clean() {
    local msg="$1" rc="${2:-0}"
    teardown_footer
    printf '\e[r'                              # scroll region di nuovo piena
    printf '\e[?25h'                           # cursore visibile
    printf '\e[H\e[2J\e[3J'                    # come `clear`, ma senza dipendere dal binario
    printf '%s\n' "$msg"
    exit "$rc"
}

# redraw the pinned TOTAL bar; argument = overall progress in per-mille (0..1000)
# on the fixed phase-band scale. Uses absolute positioning + save/restore so it
# never disturbs the scrolling pipeline above it.
draw_total_footer() {
    local pm=$1
    (( pm < 0 )) && pm=0; (( pm > 1000 )) && pm=1000
    local w=$(( TERM_COLS - 34 )); (( w > 40 )) && w=40; (( w < 8 )) && w=8
    printf '\e7'
    printf '\e[%d;1H%s%s%s\e[K' $(( TERM_ROWS - 1 )) "$DIM" "$(rep $(( TERM_COLS > 2 ? TERM_COLS - 2 : 1 )) '─')" "$RESET"
    printf '\e[%d;1H' "$TERM_ROWS"
    printf '   %sTOTAL%s  %s  %s%3s%%%s   %s%d packages%s\e[K' \
        "$BOLD" "$RESET" "$(draw_bar "$pm" 1000 "$w")" \
        "$BOLD" "$(pct "$pm" 1000)" "$RESET" \
        "$DIM" "$G_TOTAL_PKG" "$RESET"
    printf '\e8'
}

#== Pipeline drawing =========================================================

# vertical connector between two pipeline nodes
connector() {
    if (( FIRST_STEP )); then FIRST_STEP=0; else printf '   %s┃%s\n' "$DIM" "$RESET"; fi
}

# redraw the live 3-line block (spinner node + counter + section bar);
# sd/st are the section progress as done/total of any matching scale
render_live() {
    local spin=$1 label=$2 el=$3 counter=$4 sd=$5 st=$6
    (( LIVE_DRAWN )) && printf '\e[%dA' "$LIVE_LINES"
    LIVE_DRAWN=1
    printf '\r   %s%s%s  %s   %s%s%s\e[K\n' "$CYAN" "$spin" "$RESET" "$label" "$DIM" "$el" "$RESET"
    printf '\r      %s%s%s\e[K\n' "$DIM" "$counter" "$RESET"
    printf '\r      %ssection%s %s %s%3s%%%s\e[K\n' "$DIM" "$RESET" "$(draw_bar "$sd" "$st" 22)" "$DIM" "$(pct "$sd" "$st")" "$RESET"
}

# collapse the live block into a single result node line
finish_node() {
    local sym=$1 color=$2 label=$3
    (( LIVE_DRAWN )) && printf '\e[%dA' "$LIVE_LINES"
    printf '\r   %s%s%s  %s\e[K\n' "$color" "$sym" "$RESET" "$label"
    (( LIVE_DRAWN )) && printf '\e[J'
    LIVE_DRAWN=0
}

# error box with the tail of the command log
error_box() {
    local log=$1
    printf '   %s┃%s\n' "$DIM" "$RESET"
    printf '   %s┗━ error detail ─────────────────────────────%s\n' "$RED" "$RESET"
    tail -n 8 "$log" | sed "s/^/      ${DIM}│${RESET} /"
    printf '   %s──────────────────────────────────────────────%s\n' "$RED" "$RESET"
}

#== Interactive questions from a running command ==============================
# Recognized questions, with or without a newline, surface after ~1.8 s.
# Ignore terminal controls and blank lines when recognizing them: a color reset
# after "[y/N]" or an extra newline must not make the question disappear.
#
# Serve davvero anche qui: DEBIAN_FRONTEND=noninteractive zittisce debconf, ma
# **non** dpkg, che per un conffile modificato chiede lo stesso e aspetta sul
# terminale ("*** file ... (Y/I/N/O/D/Z) [default=N] ?").
#
# No text heuristic can recognize every prompt (e.g. a numbered menu). After a
# long silence, expose the recent log anyway, without claiming that a slow
# command is necessarily asking a question. Never supply an answer.
#
# That fallback must stay rarer than the real thing: apt-get goes quiet for tens
# of seconds while it unpacks a big package, and there the box freezes a bar that
# is doing fine. 45 s clears those pauses; a command that is genuinely stuck
# stays stuck, so the safety net still catches it.
PROMPT_TICKS=15
QUIET_TICKS=375                     # ~45 s at the 0.12 s poll interval

# The detector only sees what actually leaves the command. Writing to a pipe
# switches stdio to block buffering, which can hold a question — printed without
# a trailing newline, so nothing forces a flush — inside the buffer until much
# later output fills it: the user would sit in front of a frozen bar answering
# nothing. stdbuf helps programs that use standard C stdio buffering; it cannot
# force a program to emit a prompt that it suppresses internally.
# Note sudo drops LD_PRELOAD, so stdbuf must sit *inside* sudo to have an effect.
# Empty (and everything behaves as before) if stdbuf is not installed.
UNBUF=()
command -v stdbuf >/dev/null 2>&1 && UNBUF=(stdbuf -o0 -e0)

# Normalize one line in place for matching and safe display. Replaying a
# captured clear-screen/cursor sequence could erase the question itself.
clean_prompt_line() {
    local -n _text=$1
    local LC_ALL=C                         # ANSI ranges are ASCII, not locale collation
    local re_osc=$'\e''\][^'$'\a\e'']*('$'\a''|'$'\e''\\)'
    local re_csi=$'\e''\[[0-?]*[ -/]*[@-~]'
    local re_esc=$'\e''[@-_]'
    while [[ $_text =~ $re_osc ]]; do _text=${_text/"${BASH_REMATCH[0]}"/}; done
    while [[ $_text =~ $re_csi ]]; do _text=${_text/"${BASH_REMATCH[0]}"/}; done
    while [[ $_text =~ $re_esc ]]; do _text=${_text/"${BASH_REMATCH[0]}"/}; done
    _text=${_text%$'\r'}
    _text=${_text##*$'\r'}
    _text=${_text//$'\t'/    }
    _text=${_text//[[:cntrl:]]/}
    _text=${_text%"${_text##*[![:space:]]}"}
}

remember_prompt_line() {
    local text=$1
    local -n _last=$2
    clean_prompt_line text
    [[ -z $text ]] || _last=$text
}

# does this line read like a question waiting for an answer?
is_question() {
    local s=$1
    clean_prompt_line s
    s=${s,,}
    [[ -z $s ]] && return 1
    local re_brk='\[[^]]*[yn][^]]*\][:.]?$'        # ...[Y/n]   ...[y/N]:
    local re_par='\([yn][^)]*\)[:.]?$'             # ...(y/n):
    local re_end='[:?][[:space:]]*$'
    local re_kw='(is this ok|do you want to continue|continue|proceed|confirm|password|choose|choice|select|what would you like to do|continuare|procedere|conferma|scegli|scelta|selezion)'
    local re_enter='(press|hit|premi|premere)[[:space:]]+.*(enter|return|invio|any key|un tasto)'
    [[ $s == *'?' ]]     && return 0               # ...continue?   e il conffile di dpkg
    [[ $s =~ $re_brk ]]  && return 0
    [[ $s =~ $re_par ]]  && return 0
    [[ $s =~ $re_enter ]] && return 0
    # a keyword prompt that ends where an answer would go
    [[ $s =~ $re_end && $s =~ $re_kw ]] && return 0
    return 1
}

ask_begin() {
    local label="$1" text="$2" kind="${3:-question}" line
    trace "attesa: $label ($kind)"
    (( LIVE_DRAWN )) && printf '\e[%dA' "$LIVE_LINES"
    LIVE_DRAWN=0
    # Solo una domanda vera suona: il ripiego sul silenzio non deve trasformare
    # una pausa lunga ma sana in un allarme.
    [[ $kind == question ]] && printf '\a'
    if [[ $kind == question ]]; then
        printf '\r   %s◈%s  %s%s — the command is asking:%s\e[K\n' \
            "$GOLD" "$RESET" "$GOLD$BOLD" "$label" "$RESET"
    else
        printf '\r   %s◈%s  %s%s — no new output; recent details:%s\e[K\n' \
            "$GOLD" "$RESET" "$GOLD$BOLD" "$label" "$RESET"
    fi
    while IFS= read -r line; do
        clean_prompt_line line
        [[ -z $line ]] || printf '\r      %s│%s %s\e[K\n' "$GOLD" "$RESET" "$line"
    done <<< "$text"
    if [[ $kind == question ]]; then
        printf '\r      %s│%s %stype the answer + ENTER (goes straight to the command)%s\e[K\n' \
            "$GOLD" "$RESET" "$DIM" "$RESET"
    else
        printf '\r      %s│%s %sIf a question is shown, answer it; otherwise wait.%s\e[K\n' \
            "$GOLD" "$RESET" "$DIM" "$RESET"
    fi
    printf '\r      %s➜%s \e[K' "$GOLD" "$RESET"
    printf '\e[?25h'
}

# the command produced output again: hide the cursor and resume the pipeline
ask_end() { printf '\e[?25l\n'; }

# Idle-tick prompt detector shared by every runner. Called once per
# poll timeout with the runner's own state variables (passed by name):
#   poll_prompt <label> <pending> <stall> <asking> <last_line> <log>
poll_prompt() {
    local _lbl=$1 _log=$6
    local -n _p=$2 _s=$3 _a=$4 _l=$5
    (( _a )) && return 0                     # already showing the output
    _s=$(( _s + 1 ))
    (( _s >= PROMPT_TICKS )) || return 0
    local candidate=$_p kind=idle context
    clean_prompt_line candidate
    [[ -n $candidate ]] || candidate=$_l
    if is_question "$candidate"; then
        kind=question
    else
        (( _s >= QUIET_TICKS )) || return 0
    fi
    # Include preceding warnings/options, not just the final question line: il
    # conffile di dpkg spiega le opzioni (Y/I/N/O/D/Z) nelle righe che stanno
    # sopra, e da sola l'ultima riga non basta per rispondere.
    context=$(tail -n 12 "$_log"; [[ -z $_p ]] || printf '%s\n' "$_p")
    [[ -n $context ]] || context=${candidate:-'(no output available yet)'}
    ask_begin "$_lbl" "$context" "$kind"
    if [[ $kind == question && -n $_p ]]; then
        printf '%s\n' "$_p" >>"$_log"
        _p=''
    fi
    _a=1
}

#== Plain spinner step (no per-package progress: e.g. cromup) =================
run_step() {
    local label="$1"; shift
    local log; log=$(mktemp)
    trace "inizio: $label"
    connector
    # <&0 is not decoration: bash gives an asynchronous command /dev/null for
    # stdin, so without it the command would hit EOF the moment it asked
    # anything — the question would show up on screen with no way to answer it.
    if declare -F "$1" >/dev/null; then
        "$@" >"$log" 2>&1 <&0 &
    else
        "${UNBUF[@]}" "$@" >"$log" 2>&1 <&0 &
    fi
    local pid=$! i=0 start=$SECONDS
    local asking=0 stall=0 last_size=0 size pending='' last_line='' text
    while kill -0 "$pid" 2>/dev/null; do
        size=$(stat -c %s "$log" 2>/dev/null || echo 0)
        if (( size != last_size )); then
            last_size=$size; stall=0
            (( asking )) && { ask_end; asking=0; }
            while IFS= read -r text || [[ -n $text ]]; do
                remember_prompt_line "$text" last_line
            done < <(tail -n 12 "$log")
        else
            # Partial lines are already in this log, unlike streaming runners.
            poll_prompt "$label" pending stall asking last_line "$log"
        fi
        if (( ! asking )); then
            printf '\r   %s%s%s  %s   %s%s%s\e[K' \
                "$CYAN" "${SPIN[i%6]}" "$RESET" "$label" "$DIM" "$(fmt_time $(( SECONDS - start )))" "$RESET"
        fi
        i=$(( i + 1 )); sleep 0.12
    done
    (( asking )) && { ask_end; asking=0; }
    wait "$pid"; local rc=$?
    if (( rc == 0 )); then
        printf '\r   %s●%s  %s\e[K\n' "$GREEN" "$RESET" "$label"
        steps_ok=$(( steps_ok + 1 ))
    else
        printf '\r   %s✗%s  %s%s%s\e[K\n' "$RED" "$RESET" "$RED" "$label" "$RESET"
        steps_fail=$(( steps_fail + 1 ))
        error_box "$log"
    fi
    drop_log "$log" "$label"
}

#== Planning: resolve every section up-front so the TOTAL is known ============

# sum a field from an "apt-get -s" summary line, e.g.
#   "1 upgraded, 1 newly installed, 0 to remove and 0 not upgraded."
# field=install -> upgraded + newly installed ; field=remove -> to remove
apt_count() {
    local field="$1"; shift
    "$@" 2>/dev/null | awk -v f="$field" '
        / upgraded/ && /installed/ {
            gsub(/[,.]/, "")
            for (i = 1; i <= NF; i++) {
                if ($i == "upgraded" && up == "") up = $(i-1)
                else if ($i == "newly")          ni = $(i-1)
                else if ($i == "to")             rm = $(i-1)
            }
        }
        END { if (f == "install") print up + ni + 0; else print rm + 0 }'
}

# list Flatpak refs needing an update (mode=update) or that are unused (mode=unused)
flatpak_refs() {
    if [[ $1 == update ]]; then
        env LC_ALL=C flatpak update --no-deploy 2>/dev/null
    else
        printf 'n\n' | env LC_ALL=C flatpak uninstall --unused 2>/dev/null
    fi | awk -F'\t' '/^[[:space:]]*[0-9]+\./ { gsub(/^[ \t]+|[ \t]+$/,"",$3); if ($3!="") print $3 }'
}

plan_phase() {
    connector
    local tmp; tmp=$(mktemp)
    (
        # one metadata refresh; the upgrade below reuses these lists
        sudo -n env LC_ALL=C apt-get update >/dev/null 2>&1
        upg=$(apt_count install sudo -n env LC_ALL=C apt-get -s full-upgrade)
        rem=$(apt_count remove  sudo -n env LC_ALL=C apt-get -s autoremove)
        mapfile -t fu < <(flatpak_refs update)
        mapfile -t fx < <(flatpak_refs unused)
        {
            printf 'P_UPG=%d\n'  "${upg:-0}"
            printf 'P_REM=%d\n'  "${rem:-0}"
            printf 'FU=%s\n' "$(printf '%s\n' "${fu[@]}")"
            printf '__FUEND__\n'
            printf 'FX=%s\n' "$(printf '%s\n' "${fx[@]}")"
            printf '__FXEND__\n'
        } > "$tmp"
    ) &
    local pid=$! i=0 start=$SECONDS
    while kill -0 "$pid" 2>/dev/null; do
        printf '\r   %s%s%s  %s   %s%s%s\e[K' \
            "$CYAN" "${SPIN[i%6]}" "$RESET" "Planning updates" "$DIM" "$(fmt_time $(( SECONDS - start )))" "$RESET"
        i=$(( i + 1 )); sleep 0.12
    done
    wait "$pid"

    # parse the plan
    APT_UPG=$(sed -n 's/^P_UPG=//p' "$tmp"); APT_UPG=${APT_UPG:-0}
    APT_REM=$(sed -n 's/^P_REM=//p' "$tmp"); APT_REM=${APT_REM:-0}
    mapfile -t FU_REFS < <(sed -n '/^FU=/,/^__FUEND__$/p' "$tmp" | sed '1s/^FU=//; /^__FUEND__$/d; /^$/d')
    mapfile -t FX_REFS < <(sed -n '/^FX=/,/^__FXEND__$/p' "$tmp" | sed '1s/^FX=//; /^__FXEND__$/d; /^$/d')
    rm -f "$tmp"

    local nfu=${#FU_REFS[@]} nfx=${#FX_REFS[@]}
    G_TOTAL_PKG=$(( APT_UPG + APT_REM + nfu + nfx ))

    # Carve the 0..1000 bar into download / install / flatpak bands, weighted
    # 30/40/30 — but a phase with no work hands its weight to the others, so the
    # present phases always stretch to fill the whole bar.
    local in_tot=$(( APT_UPG + APT_REM )) fp_tot=$(( nfu + nfx ))
    local wdl=0 win=0 wfp=0
    (( APT_UPG > 0 )) && wdl=30
    (( in_tot  > 0 )) && win=40
    (( fp_tot  > 0 )) && wfp=30
    local w=$(( wdl + win + wfp )); (( w == 0 )) && w=1

    B_DLU_HI=$(( 1000 * wdl / w ))                         # end of download band
    local in_lo=$B_DLU_HI in_span=$(( 1000 * win / w ))
    local in_hi=$(( in_lo + in_span ))
    # split the install band between upgrade and autoremove by package count
    B_INU_HI=$(( in_tot > 0 ? in_lo + in_span * APT_UPG / in_tot : in_lo ))
    B_INA_HI=$in_hi
    # the flatpak band is everything left up to 1000, split update vs remove
    local fp_lo=$in_hi
    B_FPU_HI=$(( fp_tot > 0 ? fp_lo + (1000 - fp_lo) * nfu / fp_tot : fp_lo ))

    draw_total_footer 0
    printf '\r   %s●%s  Planning complete  %s(%d package(s) to process)%s\e[K\n' \
        "$GREEN" "$RESET" "$DIM" "$G_TOTAL_PKG" "$RESET"
}

#== Broken-state auto-repair =================================================
# When an APT transaction dies half-way (interrupted dpkg, unmet dependencies)
# the package DB is left "broken": every later apt call refuses to proceed
# until it is repaired. run_apt detects that state from the command log and,
# once per step, runs the standard recovery — reconfigure any half-installed
# packages, then `apt-get --fix-broken install` — before retrying the step in
# place (no need to re-launch the whole script).

# does the command log look like a broken / interrupted dpkg state?
apt_looks_broken() {
    grep -qiE 'fix-broken|dpkg was interrupted|dpkg --configure -a|unmet dependencies|errors were encountered while processing' "$1"
}

# the recovery command itself (driven as a single step through run_step)
_do_fix_broken() {
    sudo -n "${UNBUF[@]}" env LC_ALL=C DEBIAN_FRONTEND=noninteractive dpkg --configure -a
    sudo -n "${UNBUF[@]}" env LC_ALL=C DEBIAN_FRONTEND=noninteractive \
        apt-get -y -q -o Dpkg::Use-Pty=0 --fix-broken install
}

#== APT step with download + transaction progress ============================
# run_apt "Label" "Install|Remove" pkgcount dl_lo dl_hi in_lo in_hi sudo env ... apt-get -y <cmd>
#
# The download phase fills the TOTAL bar's [dl_lo,dl_hi] band, the transaction
# fills [in_lo,in_hi]; dl_lo==dl_hi means "this step never downloads".
#
# We append APT::Status-Fd=1 so apt writes machine-readable status lines
#   dlstatus:<id>:<pct>:<msg>      (overall download percentage)
#   pmstatus:<pkg>:<pct>:<msg>     (overall install percentage)
# onto stdout, interleaved with its normal text. The status lines drive the
# bars; everything else is funnelled to the log for the error box. Status goes
# to fd 1 (not a higher fd) because sudo closes inherited descriptors >= 3.
run_apt() {
    local label="$1" p2="$2" pkg="$3" dl_lo="$4" dl_hi="$5" in_lo="$6" in_hi="$7"; shift 7
    local cmd=("$@")
    local log; log=$(mktemp)
    trace "inizio: $label"
    connector

    if (( pkg == 0 )); then
        render_live "${SPIN[0]}" "$label" '00:00' 'nothing to do' 1 1
        draw_total_footer "$in_hi"
        finish_node '●' "$GREEN" "$label"; steps_ok=$(( steps_ok + 1 )); drop_log "$log" "$label"; return
    fi

    # Run the transaction; on a broken/interrupted failure, auto-repair with
    # fix-broken and retry the same step once (attempt 2).
    local rc=-1 attempt
    for attempt in 1 2; do
        local dl_pct=0 in_pct=0 saw_dl=0 installing=0 last_line=''
        local counter='resolving…' inname='' dlname=''
        local start=$SECONDS i=0 fd
        rc=-1
        (( attempt == 2 )) && counter='retrying after repair…'
        exec {fd}< <( { "${cmd[@]}" -o APT::Status-Fd=1 2>>"$log"; printf '\n__RC__%d__\n' "$?"; } )

        render_live "${SPIN[0]}" "$label" '00:00' "$counter" 0 1
        draw_total_footer "$dl_lo"

        local pending='' stall=0 asking=0 lsize=0 sz line text
        while true; do
            line=''
            if IFS= read -t 0.12 -r -u "$fd" line; then
                (( asking )) && { ask_end; asking=0; }
                [[ -n $pending ]] && { line="$pending$line"; pending=''; }
                stall=0
                case "$line" in
                    __RC__*__)
                        rc=${line#__RC__}; rc=${rc%__}; continue
                        ;;
                    dlstatus:*)
                        local rest=${line#dlstatus:}; rest=${rest#*:}   # drop the id
                        local p=${rest%%:*} msg=${rest#*:}
                        p=${p%%.*}; saw_dl=1; dl_pct=${p:-0}
                        dlname=$(trunc "$msg" 42)
                        counter="Downloading ${dl_pct}%  ${dlname}"
                        ;;
                    pmstatus:*)
                        local rest=${line#pmstatus:}
                        local pk=${rest%%:*}; rest=${rest#*:}
                        local p=${rest%%:*} msg=${rest#*:}
                        p=${p%%.*}; installing=1; in_pct=${p:-0}
                        [[ $pk == dpkg* || -z $pk ]] || inname=$pk
                        counter="$p2 ${in_pct}%  ${inname:-$(trunc "$msg" 42)}"
                        ;;
                    *)
                        printf '%s\n' "$line" >>"$log"
                        remember_prompt_line "$line" last_line
                        ;;
                esac
            else
                (( $? > 128 )) || break
                # timeout: read leaves any newline-less partial input in $line —
                # a line that then stays unfinished is a prompt awaiting an answer
                if [[ -n $line ]]; then
                    (( asking )) && { ask_end; asking=0; }
                    pending+="$line"; stall=0
                else
                    # stderr bypasses the pipe (2>>"$log"), e il conffile di dpkg
                    # esce proprio di li': un log che cresce vuol dire comando
                    # vivo, un log fermo che l'ultima riga puo' essere la domanda.
                    sz=$(stat -c %s "$log" 2>/dev/null || echo 0)
                    if (( sz != lsize )); then
                        lsize=$sz; stall=0
                        (( asking )) && { ask_end; asking=0; }
                        while IFS= read -r text || [[ -n $text ]]; do
                            remember_prompt_line "$text" last_line
                        done < <(tail -n 12 "$log")
                    else
                        poll_prompt "$label" pending stall asking last_line "$log"
                        # poll_prompt puo' aver scritto la domanda nel log: senza
                        # risincronizzare, al giro dopo quella crescita sembra
                        # output nuovo e il riquadro appena aperto viene chiuso.
                        (( asking )) && lsize=$(stat -c %s "$log" 2>/dev/null || echo 0)
                    fi
                fi
            fi
            (( asking )) && continue           # UI frozen while the user answers
            # section bar (download = first half, install = second half) and the
            # absolute TOTAL position within this step's two bands
            local f=0 pm=$dl_lo
            if (( installing )); then
                f=$(( saw_dl ? 500 + in_pct * 5 : in_pct * 10 ))
                pm=$(( in_lo + (in_hi - in_lo) * in_pct / 100 ))
            elif (( saw_dl )); then
                f=$(( dl_pct * 5 ))
                pm=$(( dl_lo + (dl_hi - dl_lo) * dl_pct / 100 ))
            fi
            (( f > 1000 )) && f=1000
            render_live "${SPIN[i%6]}" "$label" "$(fmt_time $(( SECONDS - start )))" "$counter" "$f" 1000
            draw_total_footer "$pm"
            i=$(( i + 1 ))
        done
        exec {fd}<&-
        (( asking )) && { ask_end; asking=0; }
        [[ -n $pending ]] && printf '%s\n' "$pending" >>"$log"

        (( rc == 0 )) && break
        # First-attempt failure that looks like a broken/interrupted dpkg state:
        # collapse this node to a warning, auto-repair, then loop to retry once.
        if (( attempt == 1 )) && apt_looks_broken "$log"; then
            finish_node '⚠' "$GOLD" "$label — broken state detected, auto-repairing…"
            run_step "Repairing broken packages (fix-broken)" _do_fix_broken
            connector
            : > "$log"                         # fresh log for the retry
        else
            break
        fi
    done

    draw_total_footer "$in_hi"
    if (( rc == 0 )); then
        finish_node '●' "$GREEN" "$label"; steps_ok=$(( steps_ok + 1 ))
    else
        finish_node '✗' "$RED" "$label"; steps_fail=$(( steps_fail + 1 )); error_box "$log"
    fi
    drop_log "$log" "$label"
}

# Vero se l'ultima passata di `flatpak update` (le righe del log dopo la riga
# numero $2) e' morta sui delta statici del remoto.
#
# Un delta statico e' il "pacchetto differenza" che flathub prepara fra due
# versioni: si scarica al posto dell'intero, ed e' molto piu' leggero. Ostree
# pero' rifiuta una parte di delta piu' grande del proprio limite
# (max-delta-part-size / OSTREE_MAX_DELTA_PART_SIZE) e si ferma a meta' pull:
#
#   Error: While pulling app/com.usebottles.bottles/x86_64/stable from remote
#   flathub: Decompressed delta part exceeds configured limit of 4537824 bytes
#
# Non e' un guasto del sistema locale ne' della rete: e' quel delta a essere
# fuori misura, e resta rotto a ogni tentativo finche' flathub non lo rigenera.
# La via d'uscita e' --no-static-deltas, che ignora la differenza e si porta
# giu' gli oggetti interi: piu' banda, ma l'aggiornamento passa.
flatpak_delta_failure() {
    local log=$1 mark=$2
    tail -n "+$(( mark + 1 ))" "$log" 2>/dev/null |
        grep -Eqi 'delta (part|superblock)|static delta|delta.*(exceed|invalid|corrupt)'
}

#== Flatpak section: update or remove one ref at a time ======================
# run_flatpak "Label" update|remove lo hi ref...
# Fills the TOTAL bar's [lo,hi] band as the refs complete.
run_flatpak() {
    local label="$1" mode="$2" lo="$3" hi="$4"; shift 4
    local refs=("$@") N=$#
    local log; log=$(mktemp)
    trace "inizio: $label"
    connector

    local verb; [[ $mode == update ]] && verb=Update || verb=Remove

    if (( N == 0 )); then
        render_live "${SPIN[0]}" "$label" '00:00' 'nothing to do' 1 1
        draw_total_footer "$hi"
        finish_node '●' "$GREEN" "$label"; steps_ok=$(( steps_ok + 1 )); drop_log "$log" "$label"; return
    fi

    local rc=0 start=$SECONDS i=0 idx=0 ref
    for ref in "${refs[@]}"; do
        idx=$(( idx + 1 ))
        # Un ref puo' richiedere due passate: la seconda e' il ritiro dei delta
        # statici (vedi flatpak_delta_failure), e riparte da capo col flag in piu'.
        local lrc=0 attempt=1 extra=() note='' mark=0
        while true; do
            local cur_pct=0 fd
            lrc=0
            mark=$(wc -l <"$log")
            if [[ $mode == update ]]; then
                exec {fd}< <( { "${UNBUF[@]}" env LC_ALL=C flatpak update -y "${extra[@]}" "$ref"; printf '\n__RC__%d__\n' "$?"; } 2>&1 )
            else
                exec {fd}< <( { "${UNBUF[@]}" env LC_ALL=C flatpak uninstall -y "$ref"; printf '\n__RC__%d__\n' "$?"; } 2>&1 )
            fi
            local pending='' stall=0 asking=0 last_line='' line
            while true; do
                line=''
                if IFS= read -t 0.12 -r -u "$fd" line; then
                    (( asking )) && { ask_end; asking=0; }
                    [[ -n $pending ]] && { line="$pending$line"; pending=''; }
                    stall=0
                    case "$line" in __RC__*__) lrc=${line#__RC__}; lrc=${lrc%__}; continue;; esac
                    printf '%s\n' "$line" >>"$log"
                    remember_prompt_line "$line" last_line
                    [[ $line =~ ([0-9]+)%[^0-9]*$ ]] && cur_pct=${BASH_REMATCH[1]}
                else
                    (( $? > 128 )) || break
                    # timeout: read leaves any newline-less partial input in $line —
                    # a line that then stays unfinished is a prompt awaiting an answer
                    if [[ -n $line ]]; then
                        (( asking )) && { ask_end; asking=0; }
                        pending+="$line"; stall=0
                    else
                        poll_prompt "$label" pending stall asking last_line "$log"
                    fi
                fi
                (( asking )) && continue           # UI frozen while the user answers
                local sd=$(( (idx - 1) * 1000 + cur_pct * 10 ))
                render_live "${SPIN[i%6]}" "$label" "$(fmt_time $(( SECONDS - start )))" \
                    "$verb $idx/$N: $ref$note" "$sd" "$(( N * 1000 ))"
                draw_total_footer $(( lo + (hi - lo) * sd / (N * 1000) ))
                i=$(( i + 1 ))
            done
            exec {fd}<&-
            (( asking )) && { ask_end; asking=0; }
            [[ -n $pending ]] && printf '%s\n' "$pending" >>"$log"

            (( lrc == 0 || attempt > 1 )) && break
            [[ $mode == update ]] || break
            flatpak_delta_failure "$log" "$mark" || break
            attempt=2; extra=(--no-static-deltas); note=' (senza delta)'
            printf '%s\n' "--- ritento senza delta statici: flatpak update -y --no-static-deltas $ref" >>"$log"
            trace "delta rotto, ritento intero: $ref"
            cur_pct=0
        done
        (( lrc != 0 )) && rc=1
    done

    draw_total_footer "$hi"
    if (( rc == 0 )); then
        finish_node '●' "$GREEN" "$label"; steps_ok=$(( steps_ok + 1 ))
    else
        finish_node '✗' "$RED" "$label"; steps_fail=$(( steps_fail + 1 )); error_box "$log"
    fi
    drop_log "$log" "$label"
}

#== Reboot detection =========================================================
# Non e' un port riga per riga da FedoraUP: li' si guardano l'rpmdb e fwupd, qui
# i segnali sono altri. Il criterio resta lo stesso — dirlo solo quando e' vero.
# Un avviso di riavvio di cui non ci si puo' fidare e' peggio di nessun avviso:
# se compare dopo ogni aggiornamento, si impara a ignorarlo.

# Pacchetti il cui aggiornamento non ha effetto finche' i processi in esecuzione
# non ripartono. Nomi interi, confrontati uno per uno: un "dbus" cercato alla
# buona pescherebbe anche dbus-x11.
REBOOT_CORE_PKGS=(libc6 systemd systemd-sysv udev dbus dbus-broker dbus-daemon
                  libssl3 linux-base)

# Fill REBOOT_REASONS with everything that only takes effect after a restart.
detect_reboot_needed() {
    REBOOT_REASONS=()

    # Il segnale canonico del mondo Debian, scritto dai pacchetti stessi
    # (update-notifier-common, needrestart) quando un aggiornamento richiede un
    # riavvio. Puo' mancare del tutto se quei pacchetti non sono installati:
    # e' un indizio in piu', non l'unico — per questo sotto ce ne sono altri due.
    local flag=''
    [ -f /run/reboot-required ]     && flag=/run/reboot-required
    [ -z "$flag" ] && [ -f /var/run/reboot-required ] && flag=/var/run/reboot-required
    if [ -n "$flag" ]; then
        local pkgs=''
        [ -r "${flag}.pkgs" ] && pkgs=$(sort -u "${flag}.pkgs" 2>/dev/null | tr '\n' ' ')
        pkgs=${pkgs% }
        if [ -n "$pkgs" ]; then
            REBOOT_REASONS+=("the system asked for a reboot (packages: $pkgs)")
        else
            REBOOT_REASONS+=("the system asked for a reboot ($flag)")
        fi
    fi

    # kernel: il piu' recente installato contro quello in esecuzione
    local newest running
    running=$(uname -r)
    newest=$(dpkg-query -W -f='${Package}\n' 'linux-image-[0-9]*' 2>/dev/null |
             sed 's/^linux-image-//' | sort -V | tail -1)
    [[ -n $newest && $newest != "$running" ]] && REBOOT_REASONS+=("new kernel installed: $newest")

    # Pacchetti core riscritti dopo l'avvio: i processi in esecuzione tengono
    # ancora i file vecchi. dpkg non registra l'ora di installazione come fa
    # rpm con %{INSTALLTIME}, ma riscrive l'elenco dei file del pacchetto a ogni
    # installazione: la mtime di /var/lib/dpkg/info/<pkg>.list e' l'equivalente.
    local boot_epoch core='' pkg f mt
    boot_epoch=$(( $(date +%s) - $(cut -d. -f1 /proc/uptime 2>/dev/null || echo 0) ))
    for pkg in "${REBOOT_CORE_PKGS[@]}"; do
        for f in "/var/lib/dpkg/info/$pkg.list" "/var/lib/dpkg/info/$pkg:"*.list; do
            [ -f "$f" ] || continue                  # il glob multiarch puo' non espandersi
            mt=$(stat -c %Y "$f" 2>/dev/null || echo 0)
            (( mt > boot_epoch )) && { core+="$pkg "; break; }
        done
    done
    core=${core% }
    [[ -n $core ]] && REBOOT_REASONS+=("core packages updated since boot: $core")

    (( ${#REBOOT_REASONS[@]} > 0 ))
}

#== Domande sì/no poste dallo script stesso ==================================
# Il prompt non viene affidato a `read -p`. Bash stampa il prompt di `read -p`
# soltanto quando lo stdin del read è un terminale, e lo manda su stderr: basta
# che lo script venga lanciato con stdin diverso dal terminale (una pipe, un
# redirect, un lanciatore che passa stdin altrove) perché la domanda sparisca
# del tutto mentre il read continua ad aspettare. È il modo peggiore di
# sbagliare: si resta fermi davanti a uno schermo muto, a rispondere alla cieca.
# Qui il prompt lo stampiamo noi, e la risposta la leggiamo dal terminale vero.
#
# ask_read <variabile> — legge una riga dal terminale, non da stdin. Se non
# esiste un terminale di controllo ripiega su stdin; se non c'è nemmeno quello
# la risposta resta vuota (che per una domanda y/N vuol dire "no", la scelta
# prudente) invece di bloccare lo script per sempre.
ask_read() {
    local -n _ans=$1
    _ans=''
    # `[ -r /dev/tty ]` non basta: senza terminale di controllo (cron, un
    # lanciatore, una sessione staccata) il file c'e' e risulta leggibile, ma
    # aprirlo fallisce e bash stampa l'errore su stderr. Si tenta e si ripiega.
    if [ -r /dev/tty ] && { IFS= read -r _ans < /dev/tty; } 2>/dev/null; then
        return 0
    fi
    IFS= read -r _ans || _ans=''
}

ask_yes_no() {
    local prompt="$1" ans
    trace "chiedo: $prompt"
    printf '\e[?25h'
    printf '\a'                                   # una domanda si deve anche sentire
    printf '   %s◈%s  %s %s[y/N]%s ' "$GOLD" "$RESET" "$prompt" "$DIM" "$RESET"
    ask_read ans
    printf '\e[?25l'
    trace "risposta: '$ans'"
    [[ $ans =~ ^([yY]|[yY][eE][sS]|[sS]|[sS][iI])$ ]]
}

#== Disclaimer ===============================================================
# Mostrato a ogni avvio, prima di toccare qualsiasi cosa e prima ancora di
# chiedere la password: aggiornare un sistema è un'operazione che può andare
# storta, e chi lancia lo script deve poterlo sapere e potersi fermare a costo
# zero. Rifiutando non viene eseguito nessun comando.
disclaimer() {
    local rule; rule=$(rep 68 '─')
    printf "   %s⚠  AVVISO DI RESPONSABILITÀ — LEGGI PRIMA DI CONTINUARE%s\n" "$GOLD$BOLD" "$RESET"
    printf "   %s%s%s\n" "$DIM" "$rule" "$RESET"
    printf "      %sAGGIORNA%s esegue una sequenza di comandi di sistema (apt-get,\n" "$BOLD" "$RESET"
    printf "      flatpak) per aggiornare la tua distribuzione basata su Debian.\n\n"
    printf "      Sono operazioni che modificano il sistema in profondità: un\n"
    printf "      full-upgrade può rimuovere pacchetti per risolvere le dipendenze, e\n"
    printf "      un aggiornamento interrotto o un pacchetto difettoso possono lasciare\n"
    printf "      il sistema instabile o non avviabile.\n\n"
    printf "      AGGIORNA è distribuito %ssenza alcuna garanzia%s, come previsto dalle\n" "$BOLD" "$RESET"
    printf "      sezioni 15 e 16 della licenza GNU GPL v3. %sL'autore non risponde di\n" "$BOLD"
    printf "      danni, perdita di dati o sistemi resi inutilizzabili%s derivanti\n" "$RESET"
    printf "      dall'uso dello script.\n\n"
    printf "      %sContinuando, dichiari di usare AGGIORNA a tuo rischio e di assumerti\n" "$GOLD"
    printf "      la piena responsabilità delle modifiche apportate al tuo sistema.%s\n\n" "$RESET"
    printf "      %sSe hai dati importanti, fai un backup prima di procedere.%s\n" "$DIM" "$RESET"
    printf "   %s%s%s\n\n" "$DIM" "$rule" "$RESET"

    if ! ask_yes_no "Accetti e vuoi continuare?"; then
        exit_clean "   ${DIM}Uscita: nessuna modifica effettuata.${RESET}" 0
    fi

    # Accettato: l'avviso ha fatto il suo lavoro e non deve restare a occupare
    # lo schermo per tutto l'aggiornamento. Si pulisce tutto (scrollback
    # compreso, così non lo si ritrova scorrendo indietro), si ridisegnano
    # l'intestazione e la barra TOTAL, e il terminale torna libero per la
    # pipeline.
    printf '\e[H\e[2J\e[3J'               # come `clear`, senza dipendere dal binario
    header
    draw_total_footer 0                   # \e[2J ha cancellato anche le righe fisse
    printf '\e[?25h'                      # la password va digitata a cursore visibile
}

#== Report card =============================================================
card_line() {
    local label="$1" value="$2" vcolor="$3"
    local inner=46
    local left="  ${label}"
    local pad=$(( inner - ${#left} - ${#value} - 2 ))
    (( pad < 1 )) && pad=1
    printf '  %s│%s%s%*s%s%s%s  %s│%s\n' \
        "$CYAN" "$RESET" "$left" "$pad" '' "$vcolor" "$value" "$RESET" "$CYAN" "$RESET"
}

report_card() {
    local inner=46
    local rule; rule=$(rep "$inner" '─')
    local title='R E P O R T'
    local tpad=$(( (inner - ${#title}) / 2 ))

    echo
    printf '  %s╭%s╮%s\n' "$CYAN" "$rule" "$RESET"
    printf '  %s│%s%*s%s%s%s%*s%s│%s\n' \
        "$CYAN" "$RESET" "$tpad" '' "$GOLD$BOLD" "$title" "$RESET" \
        $(( inner - tpad - ${#title} )) '' "$CYAN" "$RESET"
    printf '  %s├%s┤%s\n' "$CYAN" "$rule" "$RESET"

    local ok_color="$GREEN"; (( steps_fail > 0 )) && ok_color="$GOLD"
    card_line "Operations succeeded" "${steps_ok}/$(( steps_ok + steps_fail ))" "$ok_color$BOLD"
    card_line "Packages processed"   "${G_TOTAL_PKG}"                            "$BOLD"
    card_line "Time elapsed"         "$(fmt_time "$SECONDS")"                     "$BOLD"
    local freed=$(( END_AVAIL - START_AVAIL ))
    if (( freed >= 0 )); then
        card_line "Space freed"  "$(kb_to_human "$freed")"   "$GREEN$BOLD"
    else
        card_line "Space used"   "$(kb_to_human "$(( -freed ))")" "$GOLD$BOLD"
    fi
    if (( ${#REBOOT_REASONS[@]} > 0 )); then
        card_line "Reboot required" "yes" "$GOLD$BOLD"
    fi
    card_line "Script update" "$SCRIPT_UPDATE"            "$BOLD"

    printf '  %s╰%s╯%s\n' "$CYAN" "$rule" "$RESET"
    echo
}

#== Cleanup: reset the scroll region, restore the cursor, stop sudo keep-alive =
cleanup() {
    printf '\e[r'                                      # reset the scroll region
    printf '\e[?25h'                                   # show the cursor again
    [ -n "${SUDO_PID:-}" ] && kill "$SUDO_PID" 2>/dev/null
}
trap cleanup EXIT INT TERM

#== START ===================================================================
trace "avvio ($(uname -r), $(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-?}"), TERM=${TERM:-?}, stdin tty: $([ -t 0 ] && echo si || echo no))"
clear
setup_footer
header

# Nulla viene toccato finché l'utente non accetta
disclaimer

# Root credentials + keep-alive (steps read package-manager output through a
# pipe, so sudo must never stop to ask for the password mid-run). Captured steps
# also use sudo -n: if the keep-alive fails, report an error instead of drawing
# over a password prompt that sudo writes straight to /dev/tty, bypassing logs.
printf '   %s🔑 Administrator authentication required...%s\n\n' "$GOLD" "$RESET"
if ! sudo -v; then
    exit_clean "   ${RED}✗ Authentication failed. Exiting.${RESET}" 1
fi
( while true; do sudo -n true; sleep 50; kill -0 "$$" 2>/dev/null || exit; done ) 2>/dev/null &
SUDO_PID=$!

printf '\e[?25l'                                        # hide the cursor
START_AVAIL=$(df --output=avail / | tail -1 | tr -d ' ')

# Resolve everything first (one metadata refresh), so the TOTAL bar is exact.
plan_phase

# The upgrade reuses the lists just refreshed during planning (no second update).
# DEBIAN_FRONTEND=noninteractive answers debconf questions with their defaults
# (a dialog frontend would wreck the TUI); dpkg conffile prompts can still
# appear — the ask_begin detector surfaces them and hands over the keyboard.
# Each step is handed its slice of the TOTAL bar computed in plan_phase.
run_apt      "System upgrade (APT)"        "Install" "$APT_UPG" 0          "$B_DLU_HI" "$B_DLU_HI" "$B_INU_HI" \
    sudo -n "${UNBUF[@]}" env LC_ALL=C DEBIAN_FRONTEND=noninteractive apt-get -y -q -o Dpkg::Use-Pty=0 full-upgrade
run_apt      "Removing orphaned packages"  "Remove"  "$APT_REM" "$B_INU_HI" "$B_INU_HI" "$B_INU_HI" "$B_INA_HI" \
    sudo -n "${UNBUF[@]}" env LC_ALL=C DEBIAN_FRONTEND=noninteractive apt-get -y -q -o Dpkg::Use-Pty=0 autoremove
run_flatpak  "Updating Flatpaks"           update "$B_INA_HI" "$B_FPU_HI" "${FU_REFS[@]}"
run_flatpak  "Removing unused Flatpaks"    remove "$B_FPU_HI" 1000         "${FX_REFS[@]}"

# Optional hook: cromup (Cromite) — excluded from the overall progress bar
if [ -x /usr/local/bin/cromup ]; then
    run_step "Updating Cromite (cromup)" cromup
fi

END_AVAIL=$(df --output=avail / | tail -1 | tr -d ' ')
teardown_footer

#== Script self-update ======================================================
# Fra l'ultimo nodo della pipeline e la scheda di resoconto c'e' un passo che non
# disegna niente: l'autoaggiornamento via rete. Se va per le lunghe lo schermo
# resta fermo sull'ultimo nodo senza spiegare perche' — e uno schermo fermo e
# muto e' indistinguibile da uno script piantato. Una riga, almeno, dice a che
# punto siamo.
printf '   %s┃%s\n' "$DIM" "$RESET"
printf '   %s⋯  controlli finali e autoaggiornamento…%s\n' "$DIM" "$RESET"

# Everything that only takes effect after a restart (kernel, core libs)
trace "inizio: analisi riavvio"
detect_reboot_needed || true
trace "fine:   analisi riavvio (${#REBOOT_REASONS[@]} motivi)"

# Timeout espliciti: senza, un mirror che non risponde lascia curl appeso a
# tempo indeterminato proprio qui, dove non si muove piu' niente a schermo.
trace "inizio: autoaggiornamento"
if curl -fsSL --connect-timeout 10 --max-time 60 \
        https://raw.githubusercontent.com/RootGPT-YouTube/DebBasedUP/main/aggiorna \
        -o /tmp/aggiorna.tmp 2>/dev/null; then
    if ! cmp -s /tmp/aggiorna.tmp /usr/local/bin/aggiorna 2>/dev/null; then
        if sudo mv /tmp/aggiorna.tmp /usr/local/bin/aggiorna && sudo chmod a+x /usr/local/bin/aggiorna; then
            SCRIPT_UPDATE='updated ✓'
        else
            SCRIPT_UPDATE='error ✗'
        fi
    else
        SCRIPT_UPDATE='already up to date'
        rm -f /tmp/aggiorna.tmp
    fi
else
    rm -f /tmp/aggiorna.tmp
    SCRIPT_UPDATE='not checked'
fi
trace "fine:   autoaggiornamento ($SCRIPT_UPDATE)"

#== Report ==================================================================
report_card

#== Reboot-class updates ====================================================
if (( ${#REBOOT_REASONS[@]} > 0 )); then
    printf '   %s⟳  A REBOOT IS REQUIRED to complete this update:%s\n' "$GOLD$BOLD" "$RESET"
    for reason in "${REBOOT_REASONS[@]}"; do
        printf '      %s•%s %s\n' "$GOLD" "$RESET" "$reason"
    done
    echo
    if ask_yes_no "Reboot now?"; then
        printf '\n   %sRebooting…%s\n' "$DIM" "$RESET"
        trace "riavvio richiesto dall'utente"
        sudo systemctl reboot || sudo reboot
        exit 0
    fi
    printf '      %sRemember to reboot to finish applying the update.%s\n\n' "$DIM" "$RESET"
fi

#== Exit ====================================================================
trace "uscita normale"
[ -n "$DEBUG_DIR" ] && printf '   %sDiario di questa esecuzione: %s%s\n' "$DIM" "$DEBUG_DIR" "$RESET"
printf '\e[?25h'
printf '   %s↵ Press ENTER to close%s' "$DIM" "$RESET"
ask_read _close
clear
[ -n "$DEBUG_DIR" ] && printf 'Diario di aggiorna: %s\n' "$DEBUG_DIR"
# == End of script ==
